# Required services
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# Security: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# SQLite is convenient locally. Use a Supabase PostgreSQL URL in production.
# For Supabase, use the Session pooler connection string:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# On FastAPI Cloud, set these as environment variables in the dashboard.
DATABASE_URL=sqlite:///./rag.db
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8501

# Optional model and retrieval settings
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
TOP_K=5
MAX_UPLOAD_BYTES=10485760
